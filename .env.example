# ====================================
# 🐾 ConnPet Server - Environment Variables
# ====================================

# ====================================
# 🗄️ Database Configuration
# ====================================
DATABASE_URL="postgresql://user:password@localhost:5432/connpet"

# ====================================
# 🔐 JWT Configuration
# ====================================
# Chave secreta para assinatura dos tokens JWT
# ⚠️ IMPORTANTE: Altere para uma chave forte em produção!
# Gere uma chave: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=connpet-secret-key-change-in-production

# Tempo de expiração do token JWT
# Formatos aceitos: s (segundos), m (minutos), h (horas), d (dias)
# Exemplos: 30m, 1h, 24h, 7d
JWT_EXPIRES_IN=24h

# ====================================
# 🌐 Server Configuration
# ====================================
# Porta do servidor
PORT=5000

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ====================================
# 🔒 Security Configuration
# ====================================
# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ====================================
# 📝 Logging Configuration
# ====================================
# Nível de log: error, warn, info, debug
LOG_LEVEL=info

# ====================================
# 🚀 Node Environment
# ====================================
# Ambiente: development, production, test
NODE_ENV=development

# ====================================
# 🍪 Cookie Configuration
# ====================================
# Chave secreta para assinar cookies
# Para gerar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
COOKIE_SECRET=gere-uma-chave-secreta-aqui

# ====================================
# 📊 Grafana Loki Configuration
# ====================================
# URL do servidor Loki
LOKI_HOST=http://localhost:3100

# Autenticação básica (opcional)
LOKI_BASIC_AUTH=false
LOKI_USERNAME=
LOKI_PASSWORD=
