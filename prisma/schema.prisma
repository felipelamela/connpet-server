generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum RoleEnum {
  ADMIN
  CLINIC_ADMIN
  CLINIC_VET
  CLINIC_STAFF
  CLINIC_RECEPTIONIST
}

enum GenderEnum {
  MALE
  FEMALE
}

enum AppointmentStatusEnum {
  PENDING
  CONFIRMED
  INPROCESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentOriginEnum {
  CLINIC
  PETSHOP
}

enum StateEnum {
  AC
  AL
  AP
  AM
  BA
  CE
  DF
  ES
  GO
  MA
  MT
  MS
  MG
  PA
  PB
  PR
  PE
  PI
  RJ
  RN
  RS
  RO
  RR
  SC
  SP
  SE
  TO
}

enum ProductType {
  MEDICINE
  TOY
  FOOD
  HYGIENE
  ACCESSORY
}

enum PanelTypeEnum {
  CLINIC
  PETSHOP
  GROOMING
}

enum InternationStatusEnum {
  PENDING
  SCHEDULE
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServiceCategoryEnum {
  CONSULTATION
  EXAM
  VACCINE
  SURGERY
  HOSPITALIZATION
  BATH_GROOMING
  PETSHOP
  OTHER
}

//////////////////////////////////////////////////////////
// EMPRESAS, USUÁRIOS E ENDEREÇOS
//////////////////////////////////////////////////////////

model Address {
  id           String    @id @default(uuid())
  cep          String    @db.VarChar(8)
  street       String
  number       String    @db.VarChar(10)
  complement   String?
  neighborhood String
  city         String
  state        StateEnum
  country      String    @default("Brasil")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  Company             Company[]
  UserProfileEmployee UserProfileEmployee[]
  UserProfileTutor    UserProfileTutor[]
}

model Company {
  id         String   @id @default(uuid())
  socialName String
  tradeName  String
  cnpj       String   @unique
  email      String
  phone      String?
  addressId  String?
  address    Address? @relation(fields: [addressId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  panels         Panel[]
  products       Product[]
  employees      UserProfileEmployee[]
  vaccinations   Vaccination[]
  internations   Internation[]
  exams          Exam[]
  resultExams    ResultExam[]
  clinicVaccines ClinicVaccine[]

  @@index([cnpj])
  @@index([email])
  @@index([createdAt])
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  status    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeeProfiles UserProfileEmployee[]
  tutorProfile     UserProfileTutor?

  @@index([status])
}

model UserProfileEmployee {
  id        String     @id @default(uuid())
  userId    String
  companyId String
  document  String?
  crmv      String?
  crmvState StateEnum?
  phone     String?
  roles     RoleEnum
  addressId String?
  createdAt DateTime   @default(now())

  user              User               @relation(fields: [userId], references: [id])
  company           Company            @relation(fields: [companyId], references: [id])
  address           Address?           @relation(fields: [addressId], references: [id])
  internations      Internation[]
  medications       Medication[]
  Appointment       Appointment[]
  notesAppointments notesAppointment[]
  notesGroomings    notesGrooming[]

  @@index([userId])
  @@index([companyId])
  @@index([roles])
  @@index([crmv])
}

model UserProfileTutor {
  id        String   @id @default(uuid())
  userId    String   @unique
  document  String?
  phone     String?
  addressId String?
  createdAt DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id])
  address        Address?       @relation(fields: [addressId], references: [id])
  pets           Pet[]
  notes          NotesPet[]
  tutorCompanies TutorCompany[]
  Selling        Selling[]
  HostingPet     HostingPet[]

  @@index([userId])
  @@index([document])
}

model PetCompany {
  id        String   @id @default(uuid())
  petId     String
  panelId   String
  createdAt DateTime @default(now())

  pet   Pet   @relation(fields: [petId], references: [id])
  panel Panel @relation(fields: [panelId], references: [id])

  @@index([petId])
  @@index([panelId])
}

model TutorCompany {
  id        String   @id @default(uuid())
  tutorId   String
  panelId   String
  createdAt DateTime @default(now())

  tutor UserProfileTutor @relation(fields: [tutorId], references: [id])
  panel Panel            @relation(fields: [panelId], references: [id])

  @@index([tutorId])
  @@index([panelId])
}

model Pet {
  id              String     @id @default(uuid())
  tutorId         String
  name            String
  species         Int
  breed           Int
  birthDate       DateTime?
  color           String?
  weight          Decimal?   @db.Decimal(10, 3)
  microchipNumber String?    @unique
  observations    String?
  gender          GenderEnum
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tutor        UserProfileTutor @relation(fields: [tutorId], references: [id])
  vaccinations Vaccination[]
  appointments Appointment[]
  internations Internation[]
  medications  Medication[]
  exams        Exam[]
  notes        NotesPet[]
  petCompanies PetCompany[]
  Grooming     Grooming[]
  HostingPet   HostingPet[]

  @@index([tutorId])
  @@index([active])
  @@index([name])
}

model NotesPet {
  id          String   @id @default(uuid())
  tutorId     String
  petId       String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tutor UserProfileTutor @relation(fields: [tutorId], references: [id])
  pet   Pet              @relation(fields: [petId], references: [id])

  @@index([petId])
  @@index([tutorId])
  @@index([createdAt])
}

//////////////////////////////////////////////////////////
// PLANOS, PAINÉIS E SERVIÇOS
//////////////////////////////////////////////////////////

model Plan {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        PanelTypeEnum
  maxUsers    Int?
  active      Boolean       @default(true)
  price       Decimal       @db.Decimal(10, 2)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([active])
}

model Panel {
  id        String        @id @default(uuid())
  companyId String
  type      PanelTypeEnum
  active    PaymentStatus @default(PENDING)

  billingPeriod Int      @default(3)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company        Company        @relation(fields: [companyId], references: [id])
  service        Service[]
  petCompanies   PetCompany[]
  tutorCompanies TutorCompany[]
  Appointment    Appointment[]
  Grooming       Grooming[]
  Selling        Selling[]
  HostingPet     HostingPet[]
  paymentOrders  PaymentOrder[]

  @@index([companyId])
  @@index([type])
}

model Service {
  id          String              @id @default(uuid())
  panelId     String
  name        String              @db.VarChar(255)
  description String?
  category    ServiceCategoryEnum
  duration    Int?                @default(30)
  price       Decimal             @default(0.0) @db.Decimal(10, 2)
  commission  Decimal?            @default(0.0) @db.Decimal(10, 2)
  active      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  panel        Panel         @relation(fields: [panelId], references: [id])
  paymentItems PaymentItem[]

  @@unique([panelId, name])
  @@index([panelId])
  @@index([category])
}

//////////////////////////////////////////////////////////
// PRODUTOS E ESTOQUE
//////////////////////////////////////////////////////////

model Product {
  id             String      @id @default(uuid())
  companyId      String
  name           String
  description    String?
  type           ProductType
  batchNumber    String?
  manufacturer   String?
  quantity       Int
  pricePay       Decimal     @default(0.0) @db.Decimal(10, 2)
  priceSale      Decimal     @default(0.0) @db.Decimal(10, 2)
  expirationDate DateTime
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  clinicVaccines ClinicVaccine[]
  medications    Medication[]
  paymentItems   PaymentItem[]

  @@index([companyId])
  @@index([type])
  @@index([expirationDate])
}

//////////////////////////////////////////////////////////
// VACINAS
//////////////////////////////////////////////////////////

model ClinicVaccine {
  id        String   @id @default(uuid())
  clinicId  String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true)
  species   Int

  clinic       Company       @relation(fields: [clinicId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  vaccinations Vaccination[]

  @@unique([clinicId, productId])
  @@index([clinicId])
}

model Vaccination {
  id              String    @id @default(uuid())
  petId           String
  companyId       String
  clinicVaccineId String
  applicationDate DateTime
  nextDoseDate    DateTime?
  doseNumber      Int       @default(1)
  adverseReaction String?
  observations    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pet           Pet           @relation(fields: [petId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])
  clinicVaccine ClinicVaccine @relation(fields: [clinicVaccineId], references: [id])
}

//////////////////////////////////////////////////////////
// CONSULTAS, INTERNAÇÕES, EXAMES, MEDICAÇÕES
//////////////////////////////////////////////////////////

model Appointment {
  id             String                @id @default(uuid())
  petId          String
  panelId        String
  vetId          String?
  paymentOrderId String
  status         AppointmentStatusEnum @default(PENDING)
  type           Int
  typeSpecialty  Int
  description    String?               @db.Text
  scheduledAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pet               Pet                  @relation(fields: [petId], references: [id])
  panel             Panel                @relation(fields: [panelId], references: [id])
  paymentOrder      PaymentOrder         @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  vet               UserProfileEmployee? @relation(fields: [vetId], references: [id], onDelete: Cascade)
  medications       Medication[]
  notesAppointments notesAppointment[]

  @@index([petId])
  @@index([panelId])
  @@index([status])
  @@index([scheduledAt])
}

model notesAppointment {
  id            String  @id @default(uuid())
  vetId         String?
  appointmentId String
  description   String? @db.Text

  vet         UserProfileEmployee? @relation(fields: [vetId], references: [id], onDelete: Cascade)
  appointment Appointment          @relation(fields: [appointmentId], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model Internation {
  id               String                @id @default(uuid())
  companyId        String
  petId            String
  paymentOrderId   String?
  responsibleVetId String?
  room             String?
  status           InternationStatusEnum @default(IN_PROGRESS)
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  company        Company              @relation(fields: [companyId], references: [id])
  pet            Pet                  @relation(fields: [petId], references: [id])
  paymentOrder   PaymentOrder?        @relation(fields: [paymentOrderId], references: [id])
  responsibleVet UserProfileEmployee? @relation(fields: [responsibleVetId], references: [id])
  medications    Medication[]

  @@index([petId])
  @@index([companyId])
  @@index([status])
  @@index([startDate])
}

model Grooming {
  id             String                @id @default(uuid())
  panelId        String
  petId          String
  paymentOrderId String?
  status         InternationStatusEnum @default(IN_PROGRESS)
  startDate      DateTime
  endDate        DateTime?
  description    String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  panel          Panel           @relation(fields: [panelId], references: [id])
  pet            Pet             @relation(fields: [petId], references: [id])
  paymentOrder   PaymentOrder?   @relation(fields: [paymentOrderId], references: [id])
  notesGroomings notesGrooming[]

  @@index([petId])
  @@index([panelId])
  @@index([status])
  @@index([startDate])
}

model notesGrooming {
  id          String  @id @default(uuid())
  vetId       String?
  groomingId  String
  description String? @db.Text

  vet       UserProfileEmployee? @relation(fields: [vetId], references: [id], onDelete: Cascade)
  grooming  Grooming             @relation(fields: [groomingId], references: [id])
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model Selling {
  id             String                @id @default(uuid())
  panelId        String
  tutorId        String
  paymentOrderId String?
  status         InternationStatusEnum @default(IN_PROGRESS)
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  panel        Panel            @relation(fields: [panelId], references: [id])
  tutor        UserProfileTutor @relation(fields: [tutorId], references: [id])
  paymentOrder PaymentOrder?    @relation(fields: [paymentOrderId], references: [id])

  @@index([panelId])
  @@index([status])
  @@index([startDate])
}

model HostingPet {
  id             String                @id @default(uuid())
  panelId        String
  petId          String
  tutorId        String
  paymentOrderId String?
  status         InternationStatusEnum @default(IN_PROGRESS)
  startDate      DateTime
  endDate        DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  panel        Panel            @relation(fields: [panelId], references: [id])
  paymentOrder PaymentOrder?    @relation(fields: [paymentOrderId], references: [id])
  pet          Pet              @relation(fields: [petId], references: [id])
  tutor        UserProfileTutor @relation(fields: [tutorId], references: [id])

  @@index([panelId])
  @@index([status])
  @@index([startDate])
}

model Medication {
  id                  String    @id @default(uuid())
  petId               String
  appointmentId       String?
  internationId       String?
  prescribedByVetId   String?
  productId           String
  dosage              String?
  dosageUnit          String?
  frequency           String?
  administrationRoute String?
  startDate           DateTime
  endDate             DateTime?
  lastDosage          DateTime?
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  pet             Pet                  @relation(fields: [petId], references: [id])
  appointment     Appointment?         @relation(fields: [appointmentId], references: [id])
  internation     Internation?         @relation(fields: [internationId], references: [id])
  prescribedByVet UserProfileEmployee? @relation(fields: [prescribedByVetId], references: [id])
  product         Product              @relation(fields: [productId], references: [id])

  @@index([petId])
  @@index([appointmentId])
  @@index([internationId])
  @@index([startDate, endDate])
}

//////////////////////////////////////////////////////////
// PAGAMENTOS
//////////////////////////////////////////////////////////

model PaymentOrder {
  id         String            @id @default(uuid())
  panelId    String
  amount     Decimal           @default(0.0) @db.Decimal(10, 2)
  status     PaymentStatus
  originType PaymentOriginEnum
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  panel      Panel             @relation(fields: [panelId], references: [id])

  items        PaymentItem[]
  appointments Appointment[]
  internations Internation[]
  Grooming     Grooming[]
  Selling      Selling[]
  HostingPet   HostingPet[]

  @@index([panelId])
  @@index([status])
  @@index([createdAt])
}

model PaymentItem {
  id             String   @id @default(uuid())
  paymentOrderId String
  productId      String?
  serviceId      String?
  createdAt      DateTime @default(now())

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])
  product      Product?     @relation(fields: [productId], references: [id])
  service      Service?     @relation(fields: [serviceId], references: [id])

  @@index([paymentOrderId])
  @@index([productId])
}

//////////////////////////////////////////////////////////
// EXAMES E RESULTADOS
//////////////////////////////////////////////////////////

model Exam {
  id                   String   @id @default(uuid())
  petId                String
  requestedByVetId     String?
  requestedByCompanyId String?
  appointmentId        String?
  internationId        String?
  paymentOrderId       String?
  name                 String
  examDate             DateTime
  clinicId             String
  comments             String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  pet         Pet          @relation(fields: [petId], references: [id])
  clinic      Company      @relation(fields: [clinicId], references: [id])
  resultExams ResultExam[]

  @@index([petId])
  @@index([clinicId])
  @@index([examDate])
  @@index([requestedByVetId])
  @@index([requestedByCompanyId])
}

model ResultExam {
  id                String   @id @default(uuid())
  examId            String
  issuedByVetId     String?
  issuedByCompanyId String?
  clinicId          String
  fileUrl           String
  comments          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  exam   Exam    @relation(fields: [examId], references: [id])
  clinic Company @relation(fields: [clinicId], references: [id])

  @@index([examId])
  @@index([clinicId])
  @@index([createdAt])
}
